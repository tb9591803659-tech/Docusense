# Required for LLM-written answers. Without it the API runs in clearly-labelled extractive mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Storage (local filesystem; see README for hosting caveats)
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Retrieval
EMBEDDING_BACKEND=auto          # auto | sentence-transformers | hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=6
# MIN_SCORE=0.30                # override the embedder's default relevance threshold

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
